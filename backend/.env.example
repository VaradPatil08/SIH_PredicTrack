# Required in production
RAILPULSE_DEV_MODE=false
RAILPULSE_JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# RailRadar
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in
RAILRADAR_MONTHLY_LIMIT=1000
RAILRADAR_SAFETY_MARGIN=50
RAILRADAR_CACHE_TTL_SECONDS=300

# Local development can omit DATABASE_URL to use ./railpulse.db.
# Local development can set RAILPULSE_DEV_MODE=true and omit FRONTEND_ORIGIN/JWT secret.
